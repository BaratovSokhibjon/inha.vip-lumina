# Environment Variables for Lumina Smart Lamp
ENV=LOCAL
DEBUG=false

# Hardware Configuration
LED_STRIP_PIN=12
LED_STRIP_COUNT=60

# Button Pins
POWER_BUTTON_PIN=2
COLOR_BUTTON_PIN=3
MODE_BUTTON_PIN=4

# Potentiometer (via MCP3008 ADC)
MCP3008_CLK_PIN=11
MCP3008_MISO_PIN=9
MCP3008_MOSI_PIN=10
MCP3008_CS_PIN=8
BRIGHTNESS_CHANNEL=0

# Speaker Pin
SPEAKER_PIN=13

# Earthquake Monitoring (USGS API)
EARTHQUAKE_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_week.geojson
EARTHQUAKE_MIN_MAGNITUDE=5.5
EARTHQUAKE_CHECK_INTERVAL=300

# Location (for earthquake proximity, if implemented)
LOCATION_LAT=37.5665
LOCATION_LON=126.9780
LOCATION_CITY=Seoul

# Lamp Behavior Settings
DEFAULT_COLOR_RED=255
DEFAULT_COLOR_GREEN=255
DEFAULT_COLOR_BLUE=255

# Alert Colors
EARTHQUAKE_ALERT_COLOR=255,0,0
EMERGENCY_COLOR=255,0,255

# Brightness Settings
MIN_BRIGHTNESS=5
MAX_BRIGHTNESS=100
DEFAULT_BRIGHTNESS=50

# Auto Mode Settings
AUTO_COLOR_CYCLE_INTERVAL=30
AUTO_BRIGHTNESS_ADJUSTMENT=true

# System Settings
STATE_FILE_PATH=data/lamp_state.json
LOG_FILE_PATH=logs/lumina.log
DATABASE_PATH=data/storage.db
LOG_LEVEL=INFO

# Web Interface
WEB_UPDATE_INTERVAL=5

# Audio Settings
DEFAULT_VOLUME=50
ALERT_VOLUME=80
ALERT_SOUND_PATH=audio/alert.wav